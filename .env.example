# Copy to .env and fill in. Every value has a working default except the two
# API keys, so an empty .env is valid for running the unit test suite.
# Nested settings use a double underscore: SECTION__FIELD.

DEEPGRAM_API_KEY=
OPENAI_API_KEY=

LOG_LEVEL=INFO
LOG_JSON=false

DEEPGRAM__MODEL=nova-3-general
DEEPGRAM__DIARIZE_MODEL=latest

DEEPGRAM__LANGUAGE_MODE=detect
DEEPGRAM__DETECT_CANDIDATES=["en","fr"]
DEEPGRAM__LANGUAGE=fr

# Deepgram returns 504 past 10 min of processing time (not audio duration).
# Keep above 600 so their error surfaces instead of a local timeout.
DEEPGRAM__TIMEOUT_SEC=660
DEEPGRAM__MAX_RETRIES=3

INGESTION__MAX_DURATION_SEC=1800
INGESTION__MAX_BYTES=524288000
INGESTION__BLOCK_PRIVATE_ADDRESSES=true
INGESTION__SOCKET_TIMEOUT_SEC=30

AUDIO__SAMPLE_RATE=16000
AUDIO__CHANNELS=1
AUDIO__AUDIO_FORMAT=flac
AUDIO__DENOISE=false

SEGMENTATION__PAUSE_THRESHOLD_SEC=0.7
SEGMENTATION__MAX_SEGMENT_SEC=30
SEGMENTATION__SMOOTHING_ENABLED=false

ANALYSIS__MAP_MODEL=gpt-5-mini
ANALYSIS__REDUCE_MODEL=gpt-5
ANALYSIS__CHUNK_TOKEN_BUDGET=2000
ANALYSIS__MAP_CONCURRENCY=5
ANALYSIS__REDUCE_BATCH_SIZE=8

CACHE__ENABLED=true
CACHE__DIRECTORY=.cache/stt